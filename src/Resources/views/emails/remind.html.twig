{% extends 'emails/layout.html.twig' %}

{% block body %}
    <p>
        {% trans %}hi{% endtrans %}
        {{ user.name }}!
    </p>

    <p>
        {% trans %}to_set_up_new_password_follow_the_link{% endtrans %}
    </p>

    <table class="btn btn-primary" role="presentation">
        <tbody>
            <tr>
                <td>
                    <a
                        href="{{ url }}"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        {{ url }}
                    </a>
                </td>
            </tr>
        </tbody>
    </table>

    <p>{% trans %}thanks{% endtrans %}</p>
{% endblock %}
